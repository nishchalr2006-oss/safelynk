# SAFELYNK Environment Variables
# Copy this file to .env for local development

# Express Server Port
PORT=3000

# Supabase Project Configuration (Optional for Cloud Persistence)
# Obtain these from your Supabase Project Dashboard under Settings > API
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Device Ingestion Key (For ESP32 Bearer Authentication)
ESP32_DEVICE_INGESTION_TOKEN="tok_esp32_safelynk_prod_8842"

# Gemini AI API Key (Injected automatically by Google AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Hosted App URL
APP_URL="MY_APP_URL"
